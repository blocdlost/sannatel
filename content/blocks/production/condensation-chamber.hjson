name: condensation-chamber
localizedName: Condensation Chamber
description: "Condensates Sodium-Phosphate into Phosphor. Emits heat as a byproduct."
requirements: [
    zinc/280, graphite/120, lithium/225
]
type: HeatProducer
category: crafting
databaseTag: crafting
size: 3
buildTime: 300
health: 550

hasItems: true
itemCapacity: 10
hasLiquids: true
liquidCapacity: 80

consumes: {
    power: 1.6
  liquids: {
    liquids: [
      sodiumphosphate/0.66667
    ]
  }
}

outputItems: [
  phosphor/2
]
craftTime: 180

heatOutput: 7
warmupRate: 0.25

drawer: {
    type: DrawMulti
    drawers: [
        {
        type: DrawRegion
        suffix: "-bottom"
        }
        {
        type: DrawParticles
        color: "#DCCD22ff"
        particles: 12
        particleLife: 45
        particleSize: 3
        reverse: true
        }
        {
        type: DrawLiquidRegion
        drawLiquid: sodiumphosphate
        suffix: "-liquid"
        }
        {
        type: DrawDefault
        }
        {
        type: DrawHeatOutput
        heatColor: "#927D9Ecc"
        }
        {
        type: DrawGlowRegion
        alpha: 0.75
        color: "#98826DFF"
        }
    ]
}