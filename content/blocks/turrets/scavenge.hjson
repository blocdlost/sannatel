name: Scavenge
description: "Fires alternate laser beams in quick succession. Requires power."
size: 3
requirements: [
    7talc/400, 9phosphor/125, 9z1lithium-cell/45
]
health: 1200
buildTime: 330
category: turret
databaseTag: turret
group: turrets
type: PowerTurret
range: 185
rotateSpeed: 2.25
coolantMultiplier: 2.22223
shootCone: 5

reload: 24 #boosted 12
liquidCapacity: 120
hasLiquids: true

consumes: {
  coolant: {
    type: consumeCoolant
    allowLiquid: true
    allowGas: false
    amount: 1
 }
}

targetAir: true 
targetGround: true 
shootSound: shootLocus

shootX: 0
shootY: 8
shoot: {
  type: ShootAlternate
  shots: 1
  barrels: 2
  barrelOffset: 4
  mirror: true
}

squareSprite: false

consumes: {
    power: 3.5 #requires defining
}

shootType: {
    type: LaserBulletType
    damage: 90 #REQUIRES DEFINING
    pierce: false
    pierceCap: -1
    length: 188
    width: 10
    sideLength: 16
    sideWidth: 3.5
    colors: [
        "#AD9802ff"
        "#DCCD22ff"
        "#F0E23Cff"
    ]
    shootEffect: {
        type: ParticleEffect
        line: true
        particles: 5
        cone: 60
        length: 8
        colorFrom: "#DCCD22ff"
        colorTo: "#AD9802ff"
        lifetime: 45
    }
}

drawer: {
    type: DrawTurret
    parts: [
        {
            type: RegionPart
            suffix: -mid
            under: True
            mirror: False
            outline: True
            progress: recoil
            moveY: -1
            heatProgress: recoil 
        }
        {
            type: RegionPart
            suffix: -rbarrel
            under: false
            mirror: false
            outline: true 
            progress: recoil 
            recoilIndex: 1
            moveY: -3
            heatProgress: recoil
        }
        {
            type: RegionPart
            suffix: -lbarrel
            under: false
            mirror: false
            outline: true 
            progress: recoil
            recoilIndex: 0
            moveY: -3
            heatProgress: recoil
        }
        {
            type: RegionPart
            suffix: -r
            under: false
            mirror: false
            outline: true
            progress: warmup
            moveY: -5
            moveX: 1.5
        }
        {
            type: RegionPart
            suffix: -l
            under: false
            mirror: false
            outline: true
            progress: warmup
            moveY: -5
            moveX: -1.5
        }
    ]
}